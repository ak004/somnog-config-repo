# Copy to .env and fill in real values on the server. .env is gitignored -
# it never leaves this machine. Hostnames below are compose service names,
# not localhost, because these apps run on the same compose network.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=somnog
POSTGRES_PASSWORD=change-me
POSTGRES_DB=somnog_ems

AUTH_DATABASE_URL="postgresql://somnog:change-me@postgres:5432/somnog_ems?schema=auth"
EVENTS_DATABASE_URL="postgresql://somnog:change-me@postgres:5432/somnog_ems?schema=events"
NOTIFY_DATABASE_URL="postgresql://somnog:change-me@postgres:5432/somnog_ems?schema=notify"

# --- RabbitMQ -------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
AUTH_QUEUE=auth_queue
EVENTS_QUEUE=events_queue
NOTIFICATION_QUEUE=notification_queue
EVENTS_EXCHANGE=somnog.events

# --- Redis (BullMQ retry queue for notifications) -------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT --------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Ports (used inside each container) -----------------------------------
GATEWAY_PORT=3000
AUTH_HEALTH_PORT=3001
EVENTS_HEALTH_PORT=3002
NOTIFICATION_HEALTH_PORT=3003

# --- Mail (mailhog on this same compose network) ---------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="SomNOG Events <no-reply@somnog.so>"

# --- App --------------------------------------------------------------
APP_WEB_URL=https://somnog.example.com
DEFAULT_TIMEZONE=Africa/Mogadishu
THROTTLE_TTL=60
THROTTLE_LIMIT=100
